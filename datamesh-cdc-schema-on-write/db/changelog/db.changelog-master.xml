<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- Микросервис БД (PostgreSQL) -->
    <changeSet id="tag-1.0.0" author="team-ms">
        <tagDatabase tag="1.0.0"/>
    </changeSet>
    <includeAll path="changesets/" relativeToChangelogFile="true"/>

    <!-- DWH (Oracle) — отдельный контекст -->
    <changeSet id="tag-dwh-1.0.0" author="team-ms" context="dwh">
        <tagDatabase tag="dwh-1.0.0"/>
    </changeSet>
    <includeAll path="warehouse/" relativeToChangelogFile="true" context="dwh"/>

</databaseChangeLog>