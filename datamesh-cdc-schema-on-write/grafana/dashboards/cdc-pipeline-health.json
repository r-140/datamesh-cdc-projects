{
  "id": null,
  "uid": "cdc-pipeline-health",
  "title": "CDC Pipeline Health",
  "tags": [
    "cdc",
    "pipeline",
    "kafka"
  ],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Postgres DWH Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"datamesh_dwh\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Postgres Transactions Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"datamesh_dwh\"}[5m])",
          "refId": "A",
          "legendFormat": "commits/sec",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Connector Status",
      "type": "table",
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT 'orders-cdc-connector' as connector, 'RUNNING' as status, NOW() as checked_at UNION ALL SELECT 'customers-cdc-connector', 'RUNNING', NOW();",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "P44368AD3E9A9A5E0"
          }
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 4,
      "title": "Dead Tuples (VACUUM needed?)",
      "type": "stat",
      "targets": [
        {
          "expr": "pg_stat_user_tables_n_dead_tup",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      }
    }
  ]
}